<% pageScripts = ['/build/motorsport.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  Motorsport worldwide.

  This page is about racing everywhere, not about our own meets, which is why
  the recap videos moved here from the events page. The video player is the
  React component in client/components/motorsport/VideoShowcase.jsx. Our own clips tab is
  switched off with showClips: false, flip it to true to bring it back.

  The second section is deliberately empty for now. The plan is a feed of
  worldwide motorsport picked by an algorithm, and that has not been designed
  yet, so I would rather show an honest placeholder than something fake.
%>

<main class="container">

  <div class="page-head">
    <div>
      <h1 class="glow">Motorsport worldwide</h1>
      <p class="muted">Racing from everywhere. Recaps, results and what is coming up.</p>
    </div>
  </div>

  <!-- ---------------------------------------------------------------- recaps -->
  <section class="card">
    <h2>Race recaps</h2>
    <p class="muted small">
      The newest full video from GT World, Formula 1 and NASCAR.
      The site checks each channel for a newer one every three days.
    </p>

    <div data-react="VideoShowcase" data-props='<%- reactProps({ videos: videos, showClips: true }) %>'></div>
  </section>

  <!-- ---------------------------------------------------------------- worldwide -->
  <section class="card">
    <h2>Around the world</h2>
    <p class="muted small">
      A feed of motorsport news, results and highlights from championships
      worldwide.
    </p>

    <%# until a news site signs up, this space advertises for one %>
    <div class="partner-banner">
      <div class="partner-flag" aria-hidden="true"></div>
      <div class="partner-text">
        <p class="partner-kicker">Partner wanted</p>
        <h3>Looking for a motorsport news website to publish here</h3>
        <p>
          Run a motorsport news site? This section is yours: race news, results
          and highlights, shown to Israel's most active community of car lovers,
          with full credit and links back to your site.
        </p>
        <p class="partner-contact">
          Contact us: <a href="mailto:bykatz.business@gmail.com?subject=Motorsport%20news%20on%20Maslul">bykatz.business@gmail.com</a>
        </p>
      </div>
      <a class="btn btn-primary btn-lg" href="mailto:bykatz.business@gmail.com?subject=Motorsport%20news%20on%20Maslul">Get in touch</a>
    </div>
  </section>

</main>


<%- include('../partials/footer') %>
