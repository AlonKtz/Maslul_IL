<% pageScripts = ['/js/events.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="container">

  <div class="page-head">
    <div>
      <h1 class="glow">Meets &amp; races</h1>
      <p class="muted">Find a gathering near you, or host your own.</p>
    </div>
    <button id="toggle-create" class="btn btn-primary" type="button">Host an event</button>
  </div>

  <!-- ---------------------------------------------------------------- create -->
  <section id="create-panel" class="card collapse">
    <h2>Host a meet or a race</h2>
    <form id="event-form" novalidate>
      <input type="hidden" name="id" value="">

      <div class="form-grid">
        <div>
          <label for="ev-title">Title</label>
          <input id="ev-title" name="title" type="text" maxlength="80" required
                 placeholder="Friday night cruise">
        </div>
        <div>
          <label for="ev-type">Type</label>
          <select id="ev-type" name="type" required>
            <option value="meet">Car meet</option>
            <option value="race">Race</option>
          </select>
        </div>
        <div id="race-type-wrap" style="display:none">
          <label for="ev-racetype">Race format</label>
          <select id="ev-racetype" name="raceType">
            <option value="">Choose…</option>
            <% raceTypes.forEach(function (rt) { %>
              <option value="<%= rt %>"><%= rt %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="ev-city">City</label>
          <select id="ev-city" name="city" required>
            <option value="">Choose a city…</option>
            <% cities.forEach(function (c) { %>
              <option value="<%= c %>"><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="ev-address">Meeting point <span class="hint">(optional)</span></label>
          <input id="ev-address" name="address" type="text" maxlength="120"
                 placeholder="Port parking lot, gate 3">
        </div>
        <div>
          <label for="ev-starts">Date &amp; time</label>
          <input id="ev-starts" name="startsAt" type="datetime-local" required>
        </div>
        <div>
          <label for="ev-max">Attendee limit <span class="hint">(0 = no limit)</span></label>
          <input id="ev-max" name="maxAttendees" type="number" min="0" max="10000" value="0">
        </div>
        <div>
          <label for="ev-image">Cover photo <span class="hint">(optional)</span></label>
          <input id="ev-image" name="imageFile" type="file" accept="image/*">
        </div>
      </div>

      <label for="ev-desc">Description</label>
      <textarea id="ev-desc" name="description" rows="3" maxlength="1000"
                placeholder="What is happening, what to bring, who it is for…"></textarea>

      <p id="event-error" class="form-error"></p>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Publish event</button>
        <button id="cancel-edit" class="btn btn-ghost" type="button">Cancel</button>
      </div>
    </form>
  </section>

  <!-- ---------------------------------------------------------------- search -->
  <section class="search-panel">
    <h2 class="small" style="margin-top:0">Filter events</h2>
    <form id="event-search" novalidate>
      <div class="filter-row">
        <div>
          <label for="f-keyword">Keyword</label>
          <input id="f-keyword" name="keyword" type="text" placeholder="title or description">
        </div>
        <div>
          <label for="f-type">Type</label>
          <select id="f-type" name="type">
            <option value="">Any</option>
            <option value="meet">Meets</option>
            <option value="race">Races</option>
          </select>
        </div>
        <div>
          <label for="f-racetype">Race format</label>
          <select id="f-racetype" name="raceType">
            <option value="">Any</option>
            <% raceTypes.forEach(function (rt) { %>
              <option value="<%= rt %>"><%= rt %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="f-city">City</label>
          <select id="f-city" name="city">
            <option value="">Anywhere</option>
            <% cities.forEach(function (c) { %>
              <option value="<%= c %>"><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="f-from">From</label>
          <input id="f-from" name="dateFrom" type="date">
        </div>
        <div>
          <label for="f-to">To</label>
          <input id="f-to" name="dateTo" type="date">
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Search</button>
        <button id="clear-search" class="btn btn-ghost" type="button">Clear</button>
        <label class="small muted" style="display:flex;align-items:center;gap:.4rem;margin:0">
          <input type="checkbox" name="includePast" value="true" style="width:auto"> include past events
        </label>
      </div>
    </form>
  </section>

  <!-- ---------------------------------------------------------------- tabs -->
  <div class="tabs" id="event-tabs">
    <button class="tab is-active" data-tab="panel-all" type="button">All upcoming</button>
    <button class="tab" data-tab="panel-mine" type="button">Hosting</button>
    <button class="tab" data-tab="panel-going" type="button">Going</button>
  </div>

  <div id="panel-all" class="tab-panel is-active">
    <div id="events-all" class="grid"></div>
  </div>
  <div id="panel-mine" class="tab-panel">
    <div id="events-mine" class="grid"></div>
  </div>
  <div id="panel-going" class="tab-panel">
    <div id="events-going" class="grid"></div>
  </div>

</main>

<%- include('../partials/footer') %>
