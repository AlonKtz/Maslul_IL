<% pageScripts = ['/build/events.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  Meets and races.
  The whole page is React (client/components/events/): the host form, the
  filters, the tabs and the grid. The server hands over the cities, race
  formats and circuits, so the dropdowns only offer values the model accepts.
%>

<% var eventsProps = {
     cities: cities,
     raceTypes: raceTypes,
     circuits: circuits.map(function (c) {
       return { id: c.id, name: c.name, lengthKm: c.lengthKm, unit: c.unit, raceTypes: c.raceTypes };
     })
   }; %>
<main class="container">
  <div data-react="EventsPage" data-props='<%- reactProps(eventsProps) %>'></div>
</main>

<%- include('../partials/footer') %>
