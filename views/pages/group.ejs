<% pageScripts = ['/build/group.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  One group's page.

  This page changes a lot depending on who is looking at it. isManager decides
  whether the settings form and the join requests section exist at all, and
  isMember decides whether you see Join or Leave. Both come from the
  controller. Hiding them here is only for tidiness, the real check is on the
  server, so removing the hidden markup in devtools gets you nowhere.
%>

<main class="container">

  <div class="page-head">
    <div>
      <span class="badge"><%= group.category %></span>
      <% if (group.isPrivate) { %><span class="badge badge-private">Private</span><% } %>
      <h1 class="glow"><%= group.name %></h1>
      <p class="muted">
        <%= group.members.length %> member<%= group.members.length === 1 ? '' : 's' %>
        &middot; managed by
        <a href="/profile/<%= group.admin.username %>"><%= group.admin.displayName || group.admin.username %></a>
      </p>
    </div>
    <div data-react="GroupActions" data-props='<%- reactProps({ groupId: group._id, isManager: isManager, isMember: isMember }) %>'></div>
  </div>

  <% if (group.description) { %>
    <section class="card">
      <div class="text-columns"><p><%= group.description %></p></div>
    </section>
  <% } %>

  <!-- ------------------------------------------------- manager-only editing -->
  <% if (isManager) { %>
    <div data-react="GroupSettings" data-props='<%- reactProps({ categories: categories, group: { _id: group._id, name: group.name, category: group.category, brand: group.brand, description: group.description, isPrivate: group.isPrivate } }) %>'></div>
    <div data-react="JoinRequests" data-props='<%- reactProps({ groupId: group._id, pending: group.pendingRequests.map(function (p) { return { _id: p._id, username: p.username, displayName: p.displayName, avatar: p.avatar }; }) }) %>'></div>
  <% } %>

  <div class="layout-split">
    <!-- ------------------------------------------------------ group events -->
    <div data-react="GroupEvents" data-props='<%- reactProps({ groupId: group._id }) %>'></div>

    <!-- ----------------------------------------------------------- members -->
    <aside>
      <div data-react="MemberList" data-props='<%- reactProps({ groupId: group._id, adminId: group.admin._id, isManager: isManager, members: group.members.map(function (m) { return { _id: m._id, username: m.username, displayName: m.displayName, avatar: m.avatar }; }) }) %>'></div>
    </aside>
  </div>

</main>

<%- include('../partials/footer') %>
