<% pageScripts = ['/build/event.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  One event's page.

  isHost decides whether the delete button exists, and isAttending sets what
  the RSVP button says when the page first loads. After that
  public/js/event-detail.js keeps it up to date without reloading.
%>

<main class="container">

  <div class="page-head">
    <div>
      <span class="badge <%= event.type === 'race' ? 'badge-race' : 'badge-meet' %>">
        <%= event.type === 'race' ? (event.raceType || 'Race') : 'Meet' %>
      </span>
      <h1 class="glow"><%= event.title %></h1>
      <p class="muted">
        <%= event.city %><% if (event.address) { %> &middot; <%= event.address %><% } %>
      </p>
    </div>
    <% if (isHost) { %>
      <span class="react-slot" data-react="DeleteEventButton" data-props='<%- reactProps({ eventId: event._id }) %>'></span>
    <% } %>
  </div>

  <div class="layout-split">
    <div>
      <section class="card">
        <img src="<%= event.coverImage %>" alt=""
             style="width:100%;max-height:320px;object-fit:cover;border-radius:var(--radius-sm)">

        <p class="muted small" style="margin-top:1rem">
          <strong>When:</strong>
          <span class="react-slot" data-react="LocalDateTime" data-props='<%- reactProps({ value: event.startsAt }) %>'></span>
        </p>
        <p class="muted small">
          <strong>Hosted by:</strong>
          <a href="/profile/<%= event.host.username %>">
            <%= event.host.displayName || event.host.username %>
          </a>
        </p>
        <% if (event.group) { %>
          <p class="muted small">
            <strong>Group:</strong> <a href="/groups/<%= event.group._id %>"><%= event.group.name %></a>
          </p>
        <% } %>

        <% if (event.description) { %>
          <div class="text-columns" style="margin-top:1rem"><p><%= event.description %></p></div>
        <% } %>

        <%# a race gets its track drawn here. the layout points go to the
            script as json and it draws them on a canvas, so I do not need a
            picture file for every circuit %>
        <% if (circuit) { %>
          <div class="circuit-box">
            <div class="circuit-head">
              <div>
                <h3 style="margin:0"><%= circuit.name %></h3>
                <p class="muted small" style="margin:.2rem 0 0"><%= circuit.description %></p>
              </div>
            </div>
            <div data-react="CircuitCanvas" data-props='<%- reactProps({ layout: circuit.layout, closed: circuit.closed }) %>'></div>
            <div class="circuit-stats">
              <div><strong class="glow"><%= circuit.lengthKm %> km</strong><br><span class="muted small">per <%= circuit.unit === 'laps' ? 'lap' : 'run' %></span></div>
              <div><strong class="glow"><%= event.laps %></strong><br><span class="muted small"><%= circuit.unit %></span></div>
              <div><strong class="glow"><%= (circuit.lengthKm * event.laps).toFixed(1) %> km</strong><br><span class="muted small">total distance</span></div>
              <div><strong class="glow"><%= event.raceType || 'Race' %></strong><br><span class="muted small">format</span></div>
            </div>
          </div>
        <% } %>

        <div class="form-actions">
          <% if (!isHost) { %>
            <span class="react-slot" data-react="AttendButton" data-props='<%- reactProps({ eventId: event._id, attending: isAttending }) %>'></span>
          <% } else { %>
            <span class="muted small">You are hosting this event.</span>
          <% } %>
          <span class="react-slot" data-react="LikeButton" data-props='<%- reactProps({ url: "/api/events/" + event._id + "/like", count: event.likes.length }) %>'></span>
        </div>
      </section>

      <!-- ------------------------------------------------------- comments -->
      <section class="card">
        <h2>Comments</h2>

        <div data-react="Comments" data-props='<%- reactProps({ url: "/api/events/" + event._id + "/comments", initial: event.comments }) %>'></div>
      </section>
    </div>

    <!-- --------------------------------------------------------- attendees -->
    <aside>
      <section class="card" style="margin-top:0">
        <h2 class="small">
          Going
          <span class="muted">(<span id="attendee-count"><%= event.attendees.length %></span><%
            if (event.maxAttendees > 0) { %> / <%= event.maxAttendees %><% } %>)</span>
        </h2>
        <div id="attendees" class="people">
          <% event.attendees.forEach(function (a) { %>
            <a class="person" href="/profile/<%= a.username %>">
              <img src="<%= a.avatar %>" alt="">
              <span><%= a.displayName || a.username %></span>
            </a>
          <% }); %>
        </div>
        <% if (!event.attendees.length) { %>
          <p class="muted small">Nobody has signed up yet.</p>
        <% } %>
      </section>
    </aside>
  </div>

</main>

<%- include('../partials/footer') %>
