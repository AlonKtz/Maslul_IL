<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  Sign in form. It does not post normally, public/js/auth.js catches the
  submit and sends it with ajax, then redirects when the server says ok.
%>

<main class="container">
  <section class="card auth-card">
    <h1 class="glow">Welcome back</h1>
    <p class="muted">Sign in to get back on the road.</p>

    <%# client/components/auth/LoginForm.jsx %>
    <div data-react="LoginForm"></div>


    <p class="muted small">No account yet? <a href="/register">Join Maslul</a></p>

    <div class="demo-box">
      <p class="muted small">Just looking? Sign in as a demo member, no account needed.</p>
      <span class="react-slot" data-react="DemoLoginButton" data-props='{"className":"btn btn-ghost btn-block"}'><button class="btn btn-ghost btn-block" type="button">Demo User</button></span>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
