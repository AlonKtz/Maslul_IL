<% pageScripts = ['/build/admin.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  The admin page.

  There is nothing secret in this file, the protection is on the server. The
  admin router runs requireLogin and requireAdmin before any of these routes,
  so a normal member gets a 403 and never receives this html at all.
%>

<main class="container">

  <div class="page-head">
    <div>
      <h1 class="glow">Administration</h1>
      <p class="muted">
        Only site administrators can open this page. Everybody else gets a 403.
      </p>
    </div>
  </div>

  <%# the counts, the member tools and the content tools: client/components/admin/ %>
  <div data-react="AdminPage"></div>

</main>

<%- include('../partials/footer') %>
