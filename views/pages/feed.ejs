<%#
  The feed.
  The page itself is only the heading. The tabs, the timeline and the side
  boxes are React components (client/components/feed/), filled from /api/feed.
%>

<main class="container">

  <div class="page-head">
    <div>
      <h1 class="glow">Your feed</h1>
