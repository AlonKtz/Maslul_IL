        What your friends are doing and what is happening in your groups.
      </p>
    </div>
  </div>

  <%# the tabs, the timeline and the side boxes: client/components/feed/FeedPage.jsx %>
  <div data-react="FeedPage"></div>

</main>

<%- include('../partials/footer') %>
