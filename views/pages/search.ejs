<% pageScripts = ['/build/search.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  Search.
  Three tabs, all React (client/components/search/): the satellite map where
  you draw an area, member search, and group search. The server hands over
  the cities for the map and the group categories.
%>

<main class="container">

  <div class="page-head">
    <div>
      <h1 class="glow">Search</h1>
      <p class="muted">Find meets and races near you, or track down members and groups.</p>
    </div>
  </div>

  <div data-react="SearchPage" data-props='<%- reactProps({ cities: cities, categories: categories }) %>'></div>

</main>

<%- include('../partials/footer') %>
