<% pageScripts = ['/build/listing.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  One item in the marketplace.
  The controller hands us the listing itself and isSeller, which says whether
  the person looking at it is the one selling it. Almost everything on this
  page is hidden or shown based on that one flag.
%>
<main class="container">

  <div class="page-head">
    <div>
      <span class="badge"><%= listing.category %></span>
      <% if (listing.status === 'sold') { %>
        <span class="badge badge-sold">Sold</span>
      <% } %>
      <h1 class="glow"><%= listing.title %></h1>
      <p class="muted"><%= listing.condition %> &middot; <%= listing.city %></p>
    </div>

    <%# only the seller gets the buttons that change the item %>
    <% if (isSeller) { %>
      <div data-react="SellerActions" data-props='<%- reactProps({ listingId: listing._id, sold: listing.status === "sold" }) %>'></div>
    <% } %>
  </div>

  <div class="layout-split">
    <div>
      <section class="card">
        <%# the first photo is shown big, the rest go underneath as thumbnails.
            if there are no photos at all I fall back to the placeholder car. %>
        <div data-react="PhotoGallery" data-props='<%- reactProps({ photos: listing.photos }) %>'></div>

        <p class="price" style="font-size:2rem;margin:1rem 0 .25rem">
          &#8362; <%= listing.price.toLocaleString('en-US') %>
        </p>

        <%# the make, model and year are only filled in when somebody is
            selling a whole car, so only show that line if one of them is set %>
        <% if (listing.make || listing.model || listing.year) { %>
          <p class="item-meta">
            <%= [listing.make, listing.model, listing.year].filter(Boolean).join(' ') %>
          </p>
        <% } %>

        <p class="muted small">Listed <span class="react-slot" data-react="LocalDateTime" data-props='<%- reactProps({ value: listing.createdAt }) %>'></span></p>

        <% if (listing.description) { %>
          <div class="text-columns" style="margin-top:1rem"><p><%= listing.description %></p></div>
        <% } %>

        <div class="form-actions">
          <span class="react-slot" data-react="LikeButton" data-props='<%- reactProps({ url: "/api/listings/" + listing._id + "/like", count: listing.likes.length, label: "Save" }) %>'></span>
          <% if (!isSeller) { %>
            <a class="btn btn-primary" href="/chat?to=<%= listing.seller._id %>">Message the seller</a>
          <% } %>
        </div>
      </section>

      <%# questions from buyers. same comment setup as the event page. %>
      <section class="card">
        <h2>Questions</h2>

        <div data-react="Comments" data-props='<%- reactProps({ url: "/api/listings/" + listing._id + "/comments", initial: listing.comments, label: "Ask the seller something", placeholder: "Is it still available? Would you post it?", buttonText: "Post question", postedText: "Question posted", removedText: "Removed" }) %>'></div>
      </section>
    </div>

    <aside>
      <section class="card" style="margin-top:0">
        <h2 class="small">Seller</h2>
        <a class="person" href="/profile/<%= listing.seller.username %>">
          <img src="<%= listing.seller.avatar %>" alt="">
          <span><%= listing.seller.displayName || listing.seller.username %></span>
        </a>
        <% if (listing.seller.location) { %>
          <p class="muted small" style="margin-top:.75rem">Based in <%= listing.seller.location %></p>
        <% } %>
        <p class="muted small">Item is in <%= listing.city %></p>
      </section>

      <section class="card">
        <h2 class="small">Details</h2>
        <p class="item-meta">Category: <%= listing.category %></p>
        <p class="item-meta">Condition: <%= listing.condition %></p>
        <% if (listing.year) { %><p class="item-meta">Year: <%= listing.year %></p><% } %>
        <p class="item-meta">
          Status: <%= listing.status === 'sold' ? 'Sold' : 'Available' %>
        </p>
      </section>
    </aside>
  </div>

</main>

<%- include('../partials/footer') %>
