<% pageScripts = ['/build/chat.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  Chat.
  The whole page is React (client/components/chat/): the conversation list,
  friends, the open thread, the message box and the message search. Messages
  travel over a WebSocket (Socket.io), which shares the site's session so the
  server knows who is connected. The server hands over my friends, and
  openWith when I came here with "Message" from someone's profile.
%>

<main class="container chat-page">
  <div data-react="ChatPage" data-props='<%- reactProps({
    openWith: openWith,
    friends: friends.map(function (f) { return { _id: f._id, username: f.username, displayName: f.displayName, avatar: f.avatar }; })
  }) %>'></div>
</main>

<%- include('../partials/footer') %>
