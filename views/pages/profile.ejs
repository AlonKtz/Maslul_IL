<% pageScripts = ['/build/profile.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  A member's profile.

  isSelf is the flag that matters here. If it is your own profile you get the
  edit form and the delete account button. If it is somebody else's you get
  the friend button and a link to message them instead.
%>

<main class="container">

  <div class="page-head">
    <div style="display:flex;align-items:center;gap:1rem">
      <img src="<%= user.avatar %>" alt="" width="72" height="72"
           style="border-radius:50%;border:3px solid var(--border);object-fit:cover">
      <div>
        <h1 class="glow" style="margin:0"><%= user.displayName || user.username %></h1>
        <p class="muted" style="margin:0">
          @<%= user.username %><% if (user.location) { %> &middot; <%= user.location %><% } %>
        </p>
      </div>
    </div>

    <div data-react="ProfileActions" data-props='<%- reactProps({ profileId: user._id, isSelf: isSelf, isFriend: isFriend, requestSent: requestSent }) %>'></div>
  </div>

  <% if (user.bio) { %>
    <section class="card"><p style="margin:0"><%= user.bio %></p></section>
  <% } %>

  <!-- ------------------------------------------------------- edit own profile -->
  <% if (isSelf) { %>
    <div data-react="ProfileEditForm" data-props='<%- reactProps({ profileId: user._id, user: { displayName: user.displayName, location: user.location, bio: user.bio } }) %>'></div>
  <% } %>

  <!-- --------------------------------------------------------------- stats -->
  <section class="card">
    <div class="filter-row" style="text-align:center">
      <div><strong style="font-size:1.6rem" class="glow"><%= cars.length %></strong><br><span class="muted small">cars</span></div>
      <div><strong style="font-size:1.6rem" class="glow"><%= eventCount %></strong><br><span class="muted small">events hosted</span></div>
      <div><strong style="font-size:1.6rem" class="glow"><%= listingCount %></strong><br><span class="muted small">items listed</span></div>
      <div><strong style="font-size:1.6rem" class="glow"><%= user.friends.length %></strong><br><span class="muted small">friends</span></div>
      <div><strong style="font-size:1.6rem" class="glow"><%= groups.length %></strong><br><span class="muted small">groups</span></div>
    </div>
  </section>

  <div class="layout-split">
    <div>
      <!-- ------------------------------------------------------------ garage -->
      <section>
        <h2>Garage</h2>
        <% if (!cars.length) { %>
          <p class="empty">No cars in this garage yet.</p>
        <% } else { %>
          <div class="grid">
            <% cars.forEach(function (car) { %>
              <article class="item-card">
                <img class="item-image" src="<%= car.photo %>" alt="">
                <div class="item-body">
                  <span class="badge"><%= car.category %></span>
                  <h3 class="item-title"><%= car.year %> <%= car.make %> <%= car.model %></h3>
                  <p class="item-meta">
                    <%= [car.engine, car.horsepower ? car.horsepower + ' hp' : '', car.color].filter(Boolean).join(' · ') %>
                  </p>
                </div>
              </article>
            <% }); %>
          </div>
        <% } %>
      </section>
    </div>

    <aside>
      <!-- ----------------------------------------------------------- friends -->
      <section class="card" style="margin-top:0">
        <h2 class="small">Friends</h2>
        <% if (!user.friends.length) { %>
          <p class="muted small">No friends yet.</p>
        <% } else { %>
          <div class="people">
            <% user.friends.forEach(function (f) { %>
              <a class="person" href="/profile/<%= f.username %>">
                <img src="<%= f.avatar %>" alt="">
                <span><%= f.displayName || f.username %></span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </section>

      <!-- ------------------------------------------------------------ groups -->
      <section class="card">
        <h2 class="small">Groups</h2>
        <% if (!groups.length) { %>
          <p class="muted small">Not a member of any group.</p>
        <% } else { %>
          <div class="people">
            <% groups.forEach(function (g) { %>
              <a class="person" href="/groups/<%= g._id %>"><span><%= g.name %></span></a>
            <% }); %>
          </div>
        <% } %>
      </section>

      <!-- --------------------------------------------- incoming friend requests -->
      <% if (isSelf && requests.length) { %>
        <div data-react="FriendRequests" data-props='<%- reactProps({ requests: requests.map(function (u) { return { _id: u._id, username: u.username, displayName: u.displayName, avatar: u.avatar }; }) }) %>'></div>
      <% } %>
    </aside>
  </div>

</main>

<%- include('../partials/footer') %>
