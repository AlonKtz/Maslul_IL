<% pageScripts = ['/js/garage.js']; %>
<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%#
  The garage.
  Tab one is my own cars, tab two searches everybody else's. The search form
  in the second tab is the big one, it filters on make, model, body type,
  colour, a year range and a horsepower range.
%>

<main class="container">

  <div class="page-head">
    <div>
      <h1 class="glow">Garage</h1>
      <p class="muted">Your cars, and everyone else's.</p>
    </div>
    <button id="toggle-create" class="btn btn-primary" type="button">Add a car</button>
  </div>

  <!-- ---------------------------------------------------------------- create -->
  <section id="create-panel" class="card collapse">
    <h2>Add a car to your garage</h2>
    <form id="car-form" novalidate>
      <input type="hidden" name="id" value="">

      <div class="form-grid">
        <div>
          <label for="c-make">Make</label>
          <input id="c-make" name="make" type="text" maxlength="40" required placeholder="Toyota">
        </div>
        <div>
          <label for="c-model">Model</label>
          <input id="c-model" name="model" type="text" maxlength="40" required placeholder="Supra">
        </div>
        <div>
          <label for="c-year">Year</label>
          <input id="c-year" name="year" type="number" min="1900" max="2027" required placeholder="1998">
        </div>
        <div>
          <label for="c-category">Body type</label>
          <select id="c-category" name="category">
            <% categories.forEach(function (c) { %>
              <option value="<%= c %>"><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="c-engine">Engine</label>
          <input id="c-engine" name="engine" type="text" maxlength="40" placeholder="2JZ-GTE 3.0 turbo">
        </div>
        <div>
          <label for="c-hp">Horsepower</label>
          <input id="c-hp" name="horsepower" type="number" min="0" max="2000" placeholder="320">
        </div>
        <div>
          <label for="c-color">Colour</label>
          <input id="c-color" name="color" type="text" maxlength="30" placeholder="Renaissance red">
        </div>
        <div>
          <label for="c-photo">Photo</label>
          <input id="c-photo" name="photoFile" type="file" accept="image/*">
        </div>
      </div>

      <label for="c-desc">Notes</label>
      <textarea id="c-desc" name="description" rows="2" maxlength="500"
                placeholder="Modifications, plans, story…"></textarea>

      <p id="car-error" class="form-error"></p>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save car</button>
        <button id="cancel-edit" class="btn btn-ghost" type="button">Cancel</button>
      </div>
    </form>
  </section>

  <!-- ---------------------------------------------------------------- tabs -->
  <div class="tabs" id="garage-tabs">
    <button class="tab is-active" data-tab="panel-mine" type="button">My garage</button>
    <button class="tab" data-tab="panel-browse" type="button">Browse all cars</button>
  </div>

  <div id="panel-mine" class="tab-panel is-active">
    <div id="cars-mine" class="grid"></div>
  </div>

  <div id="panel-browse" class="tab-panel">
    <!-- ------------------------------------------------- advanced car search -->
    <section class="search-panel" style="margin-top:1.25rem">
      <h2 class="small" style="margin-top:0">Search every garage</h2>
      <form id="car-search" novalidate>
        <div class="filter-row">
          <div>
            <label for="s-make">Make</label>
            <input id="s-make" name="make" type="text" placeholder="BMW">
          </div>
          <div>
            <label for="s-model">Model</label>
            <input id="s-model" name="model" type="text" placeholder="M3">
          </div>
          <div>
            <label for="s-category">Body type</label>
            <select id="s-category" name="category">
              <option value="">Any</option>
              <% categories.forEach(function (c) { %>
                <option value="<%= c %>"><%= c %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label for="s-color">Colour</label>
            <input id="s-color" name="color" type="text" placeholder="blue">
          </div>
          <div>
            <label for="s-yfrom">Year from</label>
            <input id="s-yfrom" name="yearFrom" type="number" min="1900" max="2027" placeholder="1990">
          </div>
          <div>
            <label for="s-yto">Year to</label>
            <input id="s-yto" name="yearTo" type="number" min="1900" max="2027" placeholder="2005">
          </div>
          <div>
            <label for="s-hpmin">HP from</label>
            <input id="s-hpmin" name="hpMin" type="number" min="0" max="2000" placeholder="200">
          </div>
          <div>
            <label for="s-hpmax">HP to</label>
            <input id="s-hpmax" name="hpMax" type="number" min="0" max="2000" placeholder="600">
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Search</button>
          <button id="clear-search" class="btn btn-ghost" type="button">Clear</button>
        </div>
      </form>
    </section>

    <div id="cars-all" class="grid"></div>
  </div>

</main>

<%- include('../partials/footer') %>
