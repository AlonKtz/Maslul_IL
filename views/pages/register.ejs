<%#
  Sign up form. Same idea as the login page, auth.js handles the submit.
  The rules here (username length, password length) are checked again on the
  server, because anyone could skip the browser checks.
%>

<main class="container">
  <section class="card auth-card">
    <h1 class="glow">Join Maslul</h1>
    <p class="muted">Israel's first social network for car lovers.</p>

    <%# client/components/auth/RegisterForm.jsx %>
    <div data-react="RegisterForm"></div>


    <p class="muted small">Already a member? <a href="/login">Sign in</a></p>
  </section>
</main>

