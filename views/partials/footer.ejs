  <footer class="site-footer">
    <div class="container">
      <p>Maslul &mdash; Israel's first social network for car lovers.</p>
    </div>
  </footer>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <%# jQuery itself is loaded in the <head> (see partials/head.ejs). %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/auth.js"></script>

  <%# Each page sets a pageScripts variable at the very top with the extra
      files it needs, and this loop adds a script tag for each one. That way
      the garage page does not download the chat code and so on. %>
  <% if (typeof pageScripts !== 'undefined' && pageScripts.length) { %>
    <% pageScripts.forEach(function (src) { %>
      <script src="<%= src %>"></script>
    <% }); %>
  <% } %>
</body>
</html>
