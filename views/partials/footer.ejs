  <footer class="site-footer">
    <div class="container">
      <p>Maslul &mdash; Israel's first social network for car lovers.</p>
    </div>
  </footer>

  <%# The React side of the site. common.js runs on every page: the
      translation, the top bar controls and the toast. A page that has its
      own components lists its bundle in pageScripts at the top of the file.
      ?v= is the version of the site: browsers keep these files for a week,
      and a new deploy changes the number so they fetch fresh ones. %>
  <div data-react="Toast"></div>
  <script type="module" src="/build/common.js?v=<%= assetVersion %>"></script>

  <% if (typeof pageScripts !== "undefined" && pageScripts.length) { %>
    <% pageScripts.forEach(function (src) { %>
      <script type="module" src="<%= src %>?v=<%= assetVersion %>"></script>
    <% }); %>
  <% } %>
</body>
</html>
