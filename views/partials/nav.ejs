<%#
  The bar at the top of every page.
  It renders completely differently depending on whether somebody is logged
  in, which is what the currentUser check below does. currentUser is put there
  by the attachUser middleware, so every page has it without asking.
  The Admin link only appears for a site admin.
%>
<header class="site-header">
  <nav class="nav container">
    <a class="brand" href="/" data-no-i18n>
      <%# a waving chequered flag, drawn in svg: a grid of squares cut to a wavy flag shape %>
      <svg class="brand-mark" viewBox="0 0 40 32" width="50" height="40" aria-hidden="true">
        <defs>
          <clipPath id="flag-wave">
            <path d="M6 3 C14 0, 22 6, 30 3 S38 2, 38 3 L38 19 C30 22, 22 16, 14 19 S6 20, 6 19 Z"/>
          </clipPath>
          <pattern id="flag-checks" width="8" height="8" patternUnits="userSpaceOnUse">
            <rect width="8" height="8" fill="#f2f4f7"/>
            <rect width="4" height="4" fill="#11151a"/>
            <rect x="4" y="4" width="4" height="4" fill="#11151a"/>
          </pattern>
        </defs>
        <rect x="3" y="2" width="2.2" height="29" rx="1.1" fill="#e63946"/>
        <rect x="6" y="0" width="32" height="22" fill="url(#flag-checks)" clip-path="url(#flag-wave)"/>
      </svg>
      <span class="brand-name">Maslul</span>
    </a>

    <%
      // a link is active on its own page and on anything under it, so
      // /events/123 still lights up "Meets & races"
      var path = typeof currentPath === 'string' ? currentPath : '';
      function active(href) {
        return (path === href || path.indexOf(href + '/') === 0) ? ' class="is-active" aria-current="page"' : '';
      }
    %>
    <%# the three line menu button. it only shows on narrow screens (see
        .nav-burger in style.css); on a computer it is hidden and the links
        sit in the bar as before. public/js/nav.js opens and closes it %>
    <button type="button" class="nav-burger" aria-controls="nav-menu" aria-expanded="false" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>

    <%# everything below the logo. on a computer this wrapper is display:
        contents, so it changes nothing; on a phone it becomes the menu panel %>
    <div class="nav-menu" id="nav-menu">    <% if (currentUser) { %>
      <ul class="nav-links">
        <li><a href="/feed"<%- active('/feed') %>>Feed</a></li>
        <li><a href="/events"<%- active('/events') %>>Meets &amp; races</a></li>
        <li><a href="/market"<%- active('/market') %>>Market</a></li>
        <li><a href="/motorsport"<%- active('/motorsport') %>>Motorsport</a></li>
        <li><a href="/search"<%- active('/search') %>>Search</a></li>
        <li><a href="/groups"<%- active('/groups') %>>Groups</a></li>
        <li><a href="/garage"<%- active('/garage') %>>Garage</a></li>
        <li><a href="/chat"<%- active('/chat') %>>Chat</a></li>
        <li><a href="/stats"<%- active('/stats') %>>Stats</a></li>
        <% if (currentUser.role === 'admin') { %>
          <li><a href="/admin"<%- active('/admin') %>>Admin</a></li>
        <% } %>
      </ul>
      <div class="nav-user">
        <a class="nav-avatar<%= path === '/profile/' + currentUser.username ? ' is-active' : '' %>" href="/profile/<%= currentUser.username %>">
          <img src="<%= currentUser.avatar %>" alt="" width="32" height="32">
          <span><%= currentUser.displayName || currentUser.username %></span>
        </a>
        <button id="logout-btn" class="btn btn-ghost" type="button">Log out</button>
      <%# the language switch. data-no-i18n keeps the two labels as they are, so
          each one is always written in its own language %>
      <% var navLang = typeof lang !== 'undefined' ? lang : 'en'; %>
      <div class="lang-switch" data-no-i18n role="group" aria-label="Language">
        <button type="button" data-set-lang="he" class="<%= navLang === 'he' ? 'is-active' : '' %>" lang="he">עב</button>
        <button type="button" data-set-lang="en" class="<%= navLang === 'en' ? 'is-active' : '' %>" lang="en">EN</button>
      </div>
      <%# light / dark. the icon shows the mode you would switch to %>
      <% var navTheme = typeof theme !== 'undefined' ? theme : ''; %>
      <button type="button" class="theme-toggle" data-toggle-theme
              aria-label="<%= navTheme === 'dark' ? 'Light mode' : 'Dark mode' %>" title="<%= navTheme === 'dark' ? 'Light mode' : 'Dark mode' %>">
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
      </button>
      </div>
    <% } else { %>
      <ul class="nav-links">
        <li><a href="/login"<%- active('/login') %>>Sign in</a></li>
        <li><a class="btn btn-primary" href="/register">Join Maslul</a></li>
      </ul>
      <%# the language switch. data-no-i18n keeps the two labels as they are, so
          each one is always written in its own language %>
      <% var navLang = typeof lang !== 'undefined' ? lang : 'en'; %>
      <div class="lang-switch" data-no-i18n role="group" aria-label="Language">
        <button type="button" data-set-lang="he" class="<%= navLang === 'he' ? 'is-active' : '' %>" lang="he">עב</button>
        <button type="button" data-set-lang="en" class="<%= navLang === 'en' ? 'is-active' : '' %>" lang="en">EN</button>
      </div>
      <%# light / dark. the icon shows the mode you would switch to %>
      <% var navTheme = typeof theme !== 'undefined' ? theme : ''; %>
      <button type="button" class="theme-toggle" data-toggle-theme
              aria-label="<%= navTheme === 'dark' ? 'Light mode' : 'Dark mode' %>" title="<%= navTheme === 'dark' ? 'Light mode' : 'Dark mode' %>">
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
      </button>
    <% } %>
    </div>
  </nav>
</header>
