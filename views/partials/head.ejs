<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | Maslul' : 'Maslul' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/vendor/jquery.min.js"></script>
</head>
<%# The id of the signed-in member is published to the client here, so the
    scripts can tell "mine" from "somebody else's" without another request. %>
<body data-user-id="<%= currentUser ? currentUser._id : '' %>"
      data-user-role="<%= currentUser ? currentUser.role : 'guest' %>">
