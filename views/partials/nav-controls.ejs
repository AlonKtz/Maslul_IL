<%# The language switch and the light / dark button, used in both versions
    of the top bar. Each is a React component (client/components/nav/); the
    markup inside is what shows until React takes over, so nothing jumps. %>
<% var navLang = typeof lang !== 'undefined' ? lang : 'en'; %>
<% var navTheme = typeof theme !== 'undefined' ? theme : ''; %>
<span class="react-slot" data-react="LanguageSwitch">
  <div class="lang-switch" data-no-i18n role="group" aria-label="Language">
    <button type="button" class="<%= navLang === 'he' ? 'is-active' : '' %>" lang="he">עב</button>
    <button type="button" class="<%= navLang === 'en' ? 'is-active' : '' %>" lang="en">EN</button>
  </div>
</span>
<span class="react-slot" data-react="ThemeToggle">
  <button type="button" class="theme-toggle" aria-label="<%= navTheme === 'dark' ? 'Light mode' : 'Dark mode' %>">
    <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
  </button>
</span>
