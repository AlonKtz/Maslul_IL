{
  "name": "maslul",
  "version": "1.0.0",
  "description": "Maslul - Israel's first social network for car lovers (Web Applications final project)",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:components",
    "build:server": "esbuild server.jsx seed/seed.jsx tests/api.test.jsx tests/chat.test.jsx --bundle --platform=node --packages=external --format=cjs --target=node18 --outdir=dist --outbase=. --log-level=warning",
    "build:components": "esbuild public/components/CanvasMap.jsx public/components/VideoShowcase.jsx --outdir=public/components --target=es2019 --log-level=warning",
    "start": "node dist/server.js",
    "dev": "nodemon --watch server.jsx --watch src --watch config --watch seed --ext jsx,json --exec \"npm run build:server && node dist/server.js\"",
    "seed": "node dist/seed/seed.js",
    "seed:live": "node dist/seed/seed.js live",
    "test": "node dist/tests/api.test.js && node dist/tests/chat.test.js"
  },
  "keywords": [
    "social-network",
    "express",
    "mongodb",
    "cars"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "esbuild": "^0.24.2",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
