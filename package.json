{
  "name": "maslul",
  "version": "1.0.0",
  "description": "Maslul - Israel's first social network for car lovers (Web Applications final project)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
    "seed:live": "node seed/seed.js live",
    "build:components": "babel public/components/CanvasMap.jsx -o public/components/CanvasMap.js --presets=@babel/preset-react && babel public/components/VideoShowcase.jsx -o public/components/VideoShowcase.js --presets=@babel/preset-react",
    "test": "node tests/api.test.js && node tests/chat.test.js"
  },
  "keywords": [
    "social-network",
    "express",
    "mongodb",
    "cars"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
