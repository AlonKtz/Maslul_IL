# Copy this file to ".env" and fill in real values.
# The real ".env" is gitignored , NEVER commit your credentials.

# Server port
PORT=3000

# MongoDB Atlas connection string
# Atlas, Database, Connect, Drivers -> copy the string, then put your
# db user's password in place of <password> and add the db name (e.g. /maslul).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/maslul?retryWrites=true&w=majority

# Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

NODE_ENV=development

# Optional: YouTube video id shown as the "weekly recap" on the events page.
# Leave empty to hide that tab's embed.
RECAP_YOUTUBE_ID=
